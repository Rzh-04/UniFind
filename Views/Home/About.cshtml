@{
    ViewData["Title"] = "Campus Office & Guidelines";
}

<div class="container mt-4">
    <div class="bg-navy text-white p-5 rounded-4 shadow-sm mb-5 position-relative overflow-hidden">
        <div class="row align-items-center position-relative z-1">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3">Campus Safety & Administration</span>
                <h1 class="fw-bold display-5 text-white mb-3">University Lost & Found Central Office</h1>
                <p class="lead text-white-50 mb-0">
                    We serve the entire university community by securely holding lost valuables, facilitating online claims, and verifying ownership.
                </p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary mb-3">
                    <i class="bi bi-building"></i>
                </div>
                <h5 class="fw-bold">Office Location</h5>
                <p class="text-muted">
                    Student Union Building, Room 102<br />
                    Ground Floor (Next to Campus Security Office)
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="stat-icon bg-emerald bg-opacity-10 text-emerald mb-3">
                    <i class="bi bi-clock"></i>
                </div>
                <h5 class="fw-bold">Operating Hours</h5>
                <p class="text-muted">
                    Monday &ndash; Friday: 8:00 AM &ndash; 5:00 PM<br />
                    Saturday: 9:00 AM &ndash; 1:00 PM<br />
                    Closed on Sunday & University Holidays
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning mb-3">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h5 class="fw-bold">Claiming Procedure</h5>
                <p class="text-muted">
                    1. Submit a claim online with specific proof details.<br />
                    2. Bring valid University Student / Staff ID upon pickup.<br />
                    3. Sign verification receipt at office desk.
                </p>
            </div>
        </div>
    </div>
</div>

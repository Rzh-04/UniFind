@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <h2 class="fw-bold mb-3">Privacy & Data Policy</h2>
        <p class="text-muted">
            The University Lost & Found portal collects basic contact details (such as university email and optional phone number) solely for the purpose of verifying item ownership and facilitating claims between users and campus administration.
        </p>
        <h5 class="fw-bold mt-4">Data Security</h5>
        <p class="text-muted">
            All user credentials and sensitive claim information are stored securely in accordance with campus privacy guidelines. Proof details submitted for item claims are only accessible to the poster and authorized campus administrative staff.
        </p>
    </div>
</div>

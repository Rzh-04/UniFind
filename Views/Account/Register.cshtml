@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="bg-navy p-4 text-center text-white">
                    <div class="brand-badge rounded-circle bg-emerald text-white d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                        <i class="bi bi-person-plus fs-4"></i>
                    </div>
                    <h3 class="fw-bold text-white mb-1">Create Student Account</h3>
                    <p class="text-white-50 small mb-0">Join the campus lost & found network</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="FullName" class="form-control rounded-3" placeholder="Jane Doe" />
                            <label asp-for="FullName"><i class="bi bi-person me-1"></i> Full Name</label>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control rounded-3" placeholder="name@university.edu" />
                            <label asp-for="Email"><i class="bi bi-envelope me-1"></i> University Email</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Department" class="form-control rounded-3" placeholder="Computer Science" />
                                    <label asp-for="Department"><i class="bi bi-mortarboard me-1"></i> Department</label>
                                    <span asp-validation-for="Department" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="StudentOrStaffId" class="form-control rounded-3" placeholder="STU-12345" required />
                                    <label asp-for="StudentOrStaffId"><i class="bi bi-card-text me-1"></i> Student ID <span class="text-danger">*</span></label>
                                    <span asp-validation-for="StudentOrStaffId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" class="form-control rounded-3" placeholder="Password" />
                            <label asp-for="Password"><i class="bi bi-lock me-1"></i> Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="Confirm Password" />
                            <label asp-for="ConfirmPassword"><i class="bi bi-shield-lock me-1"></i> Confirm Password</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-emerald btn-lg w-100 rounded-pill fw-semibold shadow-sm mb-3">
                            Register Account
                        </button>

                        <div class="text-center">
                            <p class="text-muted small mb-0">
                                Already have an account? <a asp-controller="Account" asp-action="Login" class="text-accent fw-semibold text-decoration-none">Log in here</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model DashboardViewModel
@{
    ViewData["Title"] = "Campus Office Admin Dashboard";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2 text-primary"></i> Campus Lost & Found Office Dashboard</h2>
            <p class="text-muted mb-0">System metrics, pending claims approval, and category/location management</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Categories" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-folder-plus me-1"></i> Manage Categories
            </a>
            <a asp-controller="Admin" asp-action="Locations" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-geo-alt-fill me-1"></i> Manage Locations
            </a>
            <a asp-controller="Admin" asp-action="UserItems" class="btn btn-primary rounded-pill px-3">
                <i class="bi bi-grid me-1"></i> All Posts Oversight
            </a>
        </div>
    </div>

    <!-- Admin Metric Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Total Posts</div>
                        <h2 class="fw-bold mb-0 text-navy">@Model.TotalItemsCount</h2>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-layers-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card border-start border-4 border-danger">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Active Lost</div>
                        <h2 class="fw-bold mb-0 text-danger">@Model.ActiveLostCount</h2>
                    </div>
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card border-start border-4 border-emerald">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Active Found</div>
                        <h2 class="fw-bold mb-0 text-emerald">@Model.ActiveFoundCount</h2>
                    </div>
                    <div class="stat-icon bg-emerald bg-opacity-10 text-emerald">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase font-weight-bold">Pending Claims</div>
                        <h2 class="fw-bold mb-0 text-warning">@Model.PendingClaimsCount</h2>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Claims Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-5">
        <div class="card-header bg-navy text-white p-3 d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-white"><i class="bi bi-clipboard-check me-2"></i> Pending Campus Ownership Claims</h5>
            <span class="badge bg-primary rounded-pill">@Model.PendingAdminClaims.Count() Pending</span>
        </div>

        @if (!Model.PendingAdminClaims.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-check-circle fs-1 text-success d-block mb-2"></i>
                <h6>All claims reviewed!</h6>
                <small>No pending ownership claims awaiting administrative verification.</small>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Claimer Student</th>
                            <th>Target Found Item</th>
                            <th>Submitted Ownership Proof</th>
                            <th>Contact Phone</th>
                            <th>Claim Date</th>
                            <th>Admin Decision</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.PendingAdminClaims)
                        {
                            <tr>
                                <td>
                                    <strong>@(claim.ClaimerUser?.FullName ?? "Student")</strong><br />
                                    <small class="text-muted">@claim.ClaimerUser?.Email</small>
                                </td>
                                <td>
                                    <a asp-controller="Items" asp-action="Details" asp-route-id="@claim.ItemId" class="fw-bold text-accent text-decoration-none">
                                        @(claim.Item?.Title ?? "Item")
                                    </a>
                                </td>
                                <td>
                                    <div class="small text-muted" style="max-width: 280px; white-space: pre-wrap;">@claim.ProofOfOwnership</div>
                                </td>
                                <td>@claim.ContactPhoneNumber</td>
                                <td>@claim.ClaimDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <form asp-controller="Claims" asp-action="Review" method="post">
                                        <input type="hidden" name="claimId" value="@claim.Id" />
                                        <textarea name="reviewNotes" class="form-control form-control-sm mb-2" rows="2" placeholder="@(claim.Item?.ItemType == ItemType.Lost ? "Confirm the finder collection location and handover instructions..." : "Tell the owner where to collect the item and how to receive the reward...")"></textarea>
                                        <div class="d-flex gap-1">
                                            <button type="submit" name="status" value="@ClaimStatus.Approved" class="btn btn-sm btn-success rounded-pill px-3">Approve</button>
                                            <button type="submit" name="status" value="@ClaimStatus.Rejected" class="btn btn-sm btn-outline-danger rounded-pill px-3">Reject</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-5">
        <div class="card-header bg-light p-3 d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0 text-navy"><i class="bi bi-clock-history me-2"></i> Recently Reviewed Claims</h5>
            <span class="badge bg-secondary rounded-pill">@Model.ReviewedAdminClaims.Count() Reviewed</span>
        </div>
        @if (!Model.ReviewedAdminClaims.Any())
        {
            <div class="text-center py-4 text-muted">
                <small>No approved or rejected claims have been recorded yet.</small>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Found Item</th>
                            <th>Finder</th>
                            <th>Claimant</th>
                            <th>Decision</th>
                            <th>Reviewed Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.ReviewedAdminClaims)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Items" asp-action="Details" asp-route-id="@claim.ItemId" class="fw-bold text-accent text-decoration-none">
                                        @(claim.Item?.Title ?? "Item")
                                    </a>
                                </td>
                                <td>@(claim.Item?.User?.FullName ?? "Finder")</td>
                                <td>@(claim.ClaimerUser?.FullName ?? "Student")</td>
                                <td>
                                    @if (claim.Status == ClaimStatus.Approved)
                                    {
                                        <span class="badge bg-success rounded-pill">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill">Rejected</span>
                                    }
                                </td>
                                <td>@(claim.ResolvedDate?.ToLocalTime().ToString("MMM dd, yyyy") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

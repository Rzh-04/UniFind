<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University Lost & Found</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom Theme Styling -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg site-nav shadow-sm sticky-top py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    <div class="brand-badge rounded-3 bg-gradient-primary d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 38px; height: 38px;">
                        <i class="bi bi-search-heart fs-5"></i>
                    </div>
                    <span class="brand-text">Uni<span class="text-accent">Find</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse mt-2 mt-lg-0" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Items" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap me-1"></i> Browse Catalog
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> Campus Office
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-emerald text-white rounded-pill px-3 py-1 mt-1 mt-lg-0 d-inline-flex align-items-center gap-1 shadow-sm" asp-controller="Items" asp-action="Create" asp-route-type="1">
                                <i class="bi bi-plus-circle-fill"></i> Report Lost Item
                            </a>
                        </li>
                        <li class="nav-item ms-lg-1">
                            <a class="btn btn-outline-amber rounded-pill px-3 py-1 mt-1 mt-lg-0 d-inline-flex align-items-center gap-1" asp-controller="Items" asp-action="Create" asp-route-type="2">
                                <i class="bi bi-geo-alt-fill"></i> Report Found Item
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Notification Messages -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-info-circle-fill fs-5 text-info"></i>
                <div>@TempData["InfoMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- Site Footer -->
    <footer class="footer bg-navy text-white mt-auto py-4 border-top border-secondary border-opacity-25">
        <div class="container">
            <div class="row gy-4 align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 fw-bold fs-5 mb-2">
                        <i class="bi bi-building me-1 text-accent"></i> Campus Lost & Found Office
                    </div>
                    <p class="text-white-50 small mb-0">
                        Connecting students, faculty, and campus security to safely reunite lost property on campus.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex justify-content-md-end gap-3 mb-2">
                        <a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none small hover-light">Catalog</a>
                        <a asp-controller="Home" asp-action="About" class="text-white-50 text-decoration-none small hover-light">Campus Office</a>
                        <a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none small hover-light">Privacy Policy</a>
                    </div>
                    <div class="text-white-50 small">
                        &copy; @DateTime.Now.Year University Lost & Found. Built for University Project.
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
